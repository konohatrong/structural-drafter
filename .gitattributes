# Sources are written with LF by the generators; keep them LF on every checkout
* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.csv text eol=lf

# AutoCAD script files must stay CRLF for accoreconsole
*.scr text eol=crlf

# Binary drawing / image formats (if ever committed)
*.dwg binary
*.dxf binary
*.pdf binary
*.png binary
*.ctb binary

# Issued standard drawings are an exact record: every file is stored byte for byte (MANIFEST.json checksums)
standard_drawings/issued/** -text
